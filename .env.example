# Copiar a .env antes de levantar el stack: cp .env.example .env
# Ningún valor real de credenciales debe ir al repositorio.

# --- PostgreSQL / PostGIS ---
POSTGRES_DB=siata
POSTGRES_USER=siata
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Esquema/tabla donde el loader deja los datos ---
DB_SCHEMA=coberturas
DB_TABLE=clc

# --- GeoServer ---
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=changeme_geoserver
GEOSERVER_WORKSPACE=siata
GEOSERVER_DATASTORE=clc_postgis
GEOSERVER_LAYER=clc

# --- Web (Nginx): único puerto publicado al host ---
WEB_PORT=8080
